# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/CloudPilot

# JWT Authentication Configuration (Must match auth-service)
JWT_SECRET=change_this_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet Credential Encryption Key
FERNET_KEY=generate_with_cryptography_fernet_generate_key

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379/0

# Service Configuration
PORT=8001
API_BASE_URL=http://localhost:8001
